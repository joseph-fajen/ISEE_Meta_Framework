  "integration_notes": {
    "setup_instructions": [
      "1. Contact Globant to set up Enterprise AI account access",
      "2. Obtain API key and organization ID from Globant console",
      "3. Set GLOBANT_API_KEY and GLOBANT_ORG_ID environment variables",
      "4. Configure GLOBANT_BASE_URL if using custom endpoint",
      "5. Use this config with: --provider globant or set ISEE_PROVIDER_MODE=globant"
    ],
    "advantages": [
      "Enterprise-grade security and compliance features",
      "Dedicated infrastructure with SLA guarantees",
      "Advanced monitoring and usage analytics",
      "Custom model fine-tuning capabilities",
      "Direct vendor support and consultation"
    ],
    "compatibility": [
      "Fully compatible with existing ISEE architecture",
      "Works with all ISEE features (cost estimation, balanced models, etc.)",
      "Can be used alongside OpenRouter through hybrid mode",
      "Supports all existing command-line parameters"
    ]
