  "cognitive_diversity": {
    "provider_categories": {
      "frontier_labs": {
        "description": "Latest models from leading AI research labs",
        "models": ["anthropic/claude-3-opus", "openai/gpt-4-turbo", "google/gemini-pro"],
        "capabilities": ["reasoning", "analysis", "multimodal"],
        "quality_range": "8.0-10.0"
      },
      "open_source": {
        "description": "High-quality open source models",
        "models": ["meta-llama/llama-2-70b-chat", "mistralai/mixtral-8x7b-instruct"],
        "capabilities": ["instruction_following", "large_context"],
        "quality_range": "6.0-8.0"
      },
      "specialized": {
        "description": "Models optimized for specific use cases",
        "models": ["cohere/command-r-plus", "ai21/jamba-instruct"],
        "capabilities": ["rag_optimized", "large_context"],
        "quality_range": "7.0-8.0"
      },
      "budget_friendly": {
        "description": "Cost-effective models for high-volume usage",
