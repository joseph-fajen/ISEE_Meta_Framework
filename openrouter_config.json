        "filter_strategy": {
          "min_quality_score": 8.5,
          "preferred_cost_tiers": ["premium", "premium_plus"]
        },
        "model_selection": [
          "anthropic/claude-3-opus",
          "openai/gpt-4-turbo",
          "anthropic/claude-3-sonnet"
        ]
      },
      "cost_optimized": {
        "description": "Balance quality and cost for high-volume usage",
        "filter_strategy": {
          "preferred_cost_tiers": ["budget", "standard"],
          "min_quality_score": 6.0,
