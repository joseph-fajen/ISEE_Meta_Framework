      "premium_tier": {
        "description": "High-quality models $10-50/1M tokens",
        "filter_criteria": {"cost_tiers": ["premium"]},
        "use_case": "Critical analysis and high-stakes decisions"
      },
      "premium_plus_tier": {
        "description": "Top-tier models $50+/1M tokens",
        "filter_criteria": {"cost_tiers": ["premium_plus"]},
        "use_case": "Mission-critical tasks requiring best performance"
      }
    },
    "isee_use_case_mappings": {
      "deep_analysis": {
        "description": "Complex analytical tasks requiring reasoning",
        "recommended_capabilities": ["reasoning", "analysis", "large_context"],
        "min_quality_score": 8.0,
        "preferred_providers": ["anthropic", "openai"]
