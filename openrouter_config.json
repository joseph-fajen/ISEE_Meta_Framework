  "integration_notes": {
    "setup_instructions": [
      "1. Sign up for OpenRouter account at https://openrouter.ai",
      "2. Generate API key from https://openrouter.ai/keys",
      "3. Set OPENROUTER_API_KEY environment variable",
      "4. Optionally set OPENROUTER_SITE_URL and OPENROUTER_APP_NAME",
      "5. Use this config with: --config openrouter_config.json"
    ],
    "advantages": [
      "42.9x increase in model diversity compared to current ISEE setup",
