    "capability_filters": {
      "reasoning_models": {
        "description": "Models with strong reasoning capabilities",
        "filter_criteria": {"capabilities": ["reasoning"]},
        "recommended_for": ["deep_analysis", "problem_solving", "strategic_planning"]
      },
      "fast_models": {
        "description": "Models optimized for speed",
        "filter_criteria": {"capabilities": ["fast"]},
        "recommended_for": ["quick_exploration", "content_creation"]
      },
      "large_context_models": {
        "description": "Models with large context windows (32k+ tokens)",
        "filter_criteria": {"capabilities": ["large_context"]},
        "recommended_for": ["research", "synthesis", "deep_analysis"]
      },
      "coding_models": {
        "description": "Models specialized for code generation",
        "filter_criteria": {"capabilities": ["coding"]},
        "recommended_for": ["code_generation", "problem_solving"]
      },
      "multimodal_models": {
        "description": "Models that handle text and other modalities",
        "filter_criteria": {"capabilities": ["multimodal"]},
        "recommended_for": ["content_creation", "analysis"]
      }
    },
    "cost_tier_strategies": {
      "budget_tier": {
        "description": "Cost-effective models under $1/1M tokens",
        "filter_criteria": {"cost_tiers": ["budget"]},
        "use_case": "High-volume exploration and prototyping"
      },
      "standard_tier": {
        "description": "Balanced cost and quality $1-10/1M tokens",
