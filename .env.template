# ISEE Framework Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic API (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (GPT)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API (Unified access to 300+ models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://your-site.com
OPENROUTER_APP_NAME=ISEE Meta Framework

# Globant Enterprise AI API
GLOBANT_API_KEY=your_globant_api_key_here
GLOBANT_ORG_ID=your_globant_organization_id_here
GLOBANT_BASE_URL=https://console.saia.ai/tokens

# ISEE Provider Configuration
# Set the default API provider (openrouter|globant|hybrid)
ISEE_PROVIDER_MODE=openrouter
# Enable automatic fallback between providers
ISEE_FALLBACK_ENABLED=true

# Additional settings can be added below